# Copy this file to .env.local for local development.
# Never commit real secrets — see docs/07-security/ and SECURITY.md.

# --- Database (Prisma) ---
# PostgreSQL connection string. See docs/03-database/Database.md.
DATABASE_URL="postgresql://user:password@localhost:5432/commerce_core?schema=public"

# --- Prisma broad seed confirmation (CR-037-01-SEED) ---
# Required only to run `pnpm exec tsx prisma/seed.ts`, which performs BROAD
# upserts that can overwrite existing product/category data. Never set this
# in a shared/production environment. To populate Product.isFeatured on an
# existing catalog instead, use `pnpm exec tsx prisma/set-featured-products.ts`,
# which needs no confirmation because it cannot overwrite anything else.
# SEED_ALLOW_BROAD_WRITE="yes-overwrite-demo-catalog"

# --- Product currency migration confirmation (PR2-F01) ---
# Required only to run `pnpm exec tsx prisma/set-product-currency.ts`.
# This script writes to whichever database DATABASE_URL currently points
# to — merely having DATABASE_URL set is not confirmation that it is the
# intended target. Verify DATABASE_URL actually points at the database
# you mean to migrate, then set this for that one run.
# PRODUCT_CURRENCY_MIGRATION_CONFIRM="yes-i-have-verified-DATABASE_URL-targets-the-intended-database"

# --- Auth.js ---
# Generate with: pnpm exec auth secret  (or: openssl rand -base64 32)
AUTH_SECRET="replace-with-a-generated-secret"

# --- Stripe (Payment Provider, IMP-035) ---
# Server-only Stripe secret key. Use a TEST-mode key (sk_test_...) for
# local development — never a live key. Never exposed to client code.
STRIPE_SECRET_KEY="sk_test_replace-with-your-stripe-test-secret-key"

# --- Stripe Webhook (Asynchronous Payment Lifecycle, IMP-039) ---
# Signing secret for POST /api/webhooks/stripe, used to verify that a
# webhook delivery genuinely came from Stripe. For local development with
# the Stripe CLI (`stripe listen --forward-to localhost:3000/api/webhooks/stripe`),
# use the `whsec_...` value it prints. Never a live endpoint's secret in a
# non-production environment.
STRIPE_WEBHOOK_SECRET="whsec_replace-with-your-stripe-webhook-signing-secret"

# --- Stripe Publishable Key (Customer Payment UI, IMP-040) ---
# NOT secret — this is the one Stripe key meant to ship in client-side
# JavaScript (Next.js inlines any `NEXT_PUBLIC_*` variable into the
# browser bundle at build time). Use the TEST-mode publishable key
# (pk_test_...) paired with the STRIPE_SECRET_KEY above.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_replace-with-your-stripe-test-publishable-key"
