// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// =============================================================================
// Catalog — Product persistence (IMP-021)
//
// Source of truth for storefront product/category data. Presentation-facing
// UI copy (labels, empty states, buttons, etc.) stays in next-intl; only
// product-specific content (name, meta, description, material, dimensions)
// lives here, per-locale via *Translation models.
// =============================================================================

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum ProductBadge {
  NEW
  LIMITED
}

model Category {
  id        String   @id @default(cuid())
  slug      String   @unique
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  translations CategoryTranslation[]
  products     Product[]

  @@map("categories")
}

model CategoryTranslation {
  id         String @id @default(cuid())
  categoryId String
  locale     String
  name       String

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, locale])
  @@map("category_translations")
}

model Product {
  id String @id @default(cuid())

  // Canonical slug for future slug-based routing. Storefront routes remain
  // ID-based in IMP-021 (existing IDs "1".."6" are preserved; new products
  // get generated IDs — see the Product ID field default below).
  slug String @unique

  status ProductStatus @default(DRAFT)

  // Integer minor units (e.g. $240.00 -> 24000). Never floating point.
  priceAmountMinor Int
  currency         String @db.Char(3)

  categoryId String
  badge      ProductBadge?
  isFeatured Boolean       @default(false)
  sortOrder  Int           @default(0)

  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  category     Category             @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  translations ProductTranslation[]

  @@index([status])
  @@index([categoryId])
  @@index([isFeatured])
  @@index([status, sortOrder])
  @@map("products")
}

model ProductTranslation {
  id        String @id @default(cuid())
  productId String
  locale    String

  name        String
  meta        String
  description String
  material    String
  dimensions  String

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, locale])
  @@map("product_translations")
}

// =============================================================================
// Order — persistent purchase snapshot foundation (IMP-025 / ARCH-025)
//
// Order creation itself is a future milestone; this only establishes the
// persistence model so it exists without redesign later. An Order is a
// point-in-time snapshot: customer details and each line's product name/price
// are copied onto the Order/OrderItem at creation time and never re-derived
// from Product or a Customer entity (neither of which this stores a live
// reference to) — an Order must stay valid even if the Product it referenced
// later changes, is archived, or (in principle) no longer exists.
// =============================================================================

enum OrderStatus {
  PENDING
  PAID
  CANCELLED
}

model Order {
  id String @id @default(cuid())

  status OrderStatus @default(PENDING)

  // Customer snapshot, independent of `userId` below — kept even for
  // authenticated orders (a User has no name/phone of its own), and is the
  // only record of who the order is for on a guest order.
  firstName String
  lastName  String
  email     String
  phone     String

  // Nullable: guest checkout remains supported (IMP-029). Set from the
  // server-derived authenticated user at creation time, never from client
  // input. `SetNull` on delete — a historical Order must survive its
  // owning User being deleted, not be deleted or orphaned itself.
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  // Integer minor units, never floating point — same convention as Catalog.
  subtotalAmountMinor Int
  deliveryAmountMinor Int
  totalAmountMinor    Int
  currency            String @db.Char(3)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items OrderItem[]

  // Checkout submission idempotency (IMP-031). Nullable + unique: Postgres
  // treats every NULL as distinct from every other NULL, so orders created
  // without an idempotency key (e.g. the generic internal `createOrder`
  // command) coexist freely, while any two orders that DO supply a key are
  // guaranteed distinct at the database level — including guest orders,
  // where `userId` is null and therefore cannot itself be part of a safe
  // compound unique key (`UNIQUE(userId, idempotencyKey)` would let two
  // different guest submissions share one key, since Postgres never
  // considers two NULL `userId`s equal). A single-column unique constraint
  // on the required, non-null key itself has no such gap.
  idempotencyKey String? @unique

  // Hash of the client-submitted checkout payload (customer info, cart
  // items, delivery amount, resolved userId) captured when the key was
  // first used. Lets a replay of the same submission be distinguished from
  // a genuine conflict — the same key reused for a materially different
  // submission, including a different user — without storing the raw
  // payload a second time.
  idempotencyRequestHash String?

  @@index([status])
  @@index([createdAt])
  // Supports the customer order-history query: filter by owner, ordered
  // deterministically newest-first with `id` as a tiebreaker.
  @@index([userId, createdAt, id])
  @@map("orders")
}

model OrderItem {
  id      String @id @default(cuid())
  orderId String

  // Product snapshot, deliberately not a foreign key to Product: productId
  // is kept only for traceability (e.g. "which orders included product X"),
  // never dereferenced to reconstruct this line's name or price. Product
  // deletion/status changes must never affect an existing OrderItem.
  productId   String
  productName String

  unitPriceAmountMinor Int
  quantity             Int
  lineTotalAmountMinor Int
  currency             String @db.Char(3)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

// =============================================================================
// Identity — minimal application User foundation (IMP-027)
//
// Deliberately minimal: authentication credentials only. Email is always
// stored lowercased by the application layer, so the plain `@unique` below
// is sufficient for case-insensitive uniqueness without a citext extension.
// Profiles, addresses, roles, and any relation to Order belong to future
// milestones once those requirements are approved — not introduced here.
// =============================================================================

model User {
  id String @id @default(cuid())

  email String @unique

  // Never exposed outside Identity's infrastructure/application layers.
  passwordHash String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Prisma-required opposite side of `Order.user` — purely relational
  // (virtual, not a real column), not a new business-data User field.
  orders Order[]

  @@map("users")
}
