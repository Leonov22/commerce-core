# EditorConfig helps maintain consistent coding styles across editors and IDEs.
# https://editorconfig.org
# NOTE: No technology stack has been selected yet. Stack-specific overrides
# (indent style/size per language) should be appended once the Architect
# selects the technology stack.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.{bat,cmd,ps1}]
end_of_line = crlf
