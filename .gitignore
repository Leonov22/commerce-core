# =============================================================================
# .gitignore
# Stack: Next.js 15 (App Router) + TypeScript + pnpm, per TDR-001-Tech-Stack.
# =============================================================================

# --- Operating System ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# --- Editors / IDEs ---
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~
.history/

# --- Environment / Secrets ---
.env*
!.env.example
*.pem
*.key

# --- Local tooling config (machine-specific, not shared) ---
.claude/settings.local.json

# --- Logs ---
*.log
logs/

# --- Generic build / dependency output ---
dist/
build/
out/
node_modules/
*.tmp
*.temp
.cache/

# --- Next.js ---
/.next/
next-env.d.ts
*.tsbuildinfo

# --- pnpm ---
.pnpm-debug.log*
.pnpm-store/

# --- Testing ---
/coverage

# --- Prisma ---
prisma/*.db
prisma/*.db-journal

# --- Vercel ---
.vercel

/src/generated/prisma
